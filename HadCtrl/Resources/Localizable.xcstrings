            "value": "Measurement type"
          }
        }
      }
    },
    "نوع الملف غير مسموح (PDF أو صورة أو جدول).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File type not allowed (PDF, image or spreadsheet)."
          }
        }
      }
    },
    "نوفمبر ٢٠٢٦": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "November 2026"
          }
        }
      }
    },
    "نُسخت (تُمسح بعد دقيقتين)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied (cleared after two minutes)"
          }
        }
      }
    },
    "هدف جديد": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New goal"
          }
        }
      }
    },
    "هذه الشاشة لم تُربط بالخادم بعد في هذا الإصدار.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This screen is not connected to the server yet in this build."
          }
        }
      }
    },
    "وصف مختصر (اختياري)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short description (optional)"
          }
        }
      }
    },
    "وقّع بإصبعك داخل الإطار": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign with your finger inside the frame"
          }
        }
      }
    },
    "يبقى صندوق الإشعارات داخل التطبيق هو المرجع؛ تظهر على شاشة القفل عبارة عامة دون أسماء أو تفاصيل.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The in-app inbox stays the reference; the lock screen shows generic text without names or details."
          }
        }
      }
    },
    "يبقى ظاهرًا دائمًا": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always shown"
          }
        }
      }
    },
    "يرسل رئيس القسم التقرير بعد اكتماله.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The department head submits the report once it is complete."
          }
        }
      }
    },
    "يرسل رئيس القسم المنجز للاعتماد.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The department head submits the achievement for approval."
          }
        }
      }
    },
    "يستحق خلال ثلاثة أيام": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Due within three days"
          }
        }
      }
    },
    "يطلب التحقق عند فتح التطبيق": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks for verification when opening the app"
          }
        }
      }
    },
    "يعرّف مدير المستشفى المؤشرات من الإعدادات ← الإدارة.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hospital director defines indicators in Settings → Administration."
          }
        }
      }
    },
    "يفتح مدير المستشفى فترة التقارير.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hospital director opens the reporting period."
          }
        }
      }
    },
    "يفتح معاينة الملف": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a preview of the file"
          }
        }
      }
    },
    "يفحص الجهاز الإشعارات الجديدة في الخلفية حين يسمح iOS بذلك، وقد يتأخر التنبيه. لا تظهر أسماء المهام أو التقارير على شاشة القفل.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device checks for new notifications in the background when iOS allows it, so alerts may be late. Task and report names never appear on the lock screen."
          }
        }
      }
    },
    "يقرر المدير الإقفال وفق تعريف الهدف؛ اكتمال المهام وحده لا يكفي.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The director decides closure by the goal's definition; completed tasks alone are not enough."
          }
        }
      }
    },
    "يقيس النتيجة": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measures the outcome"
          }
        }
      }
    },
    "يوم الاستحقاق من ١ إلى ٢٨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Due day from 1 to 28"
          }
        }
      }
    },
    "يُحتسب الموعد حتى نهاية اليوم بتوقيت المستشفى.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deadline runs to the end of the day in hospital time."
          }
        }
      }
    },
    "يُحسب من أوزان المراحل المعتمدة فقط.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computed only from approved milestone weights."
          }
        }
      }
    },
    "يُحسب من القراءات المعتمدة للمؤشر المقيس، لا من اكتمال المهام. الإنجاز الخام قد يتجاوز ١٠٠٪ والمحتسب له سقف ١٠٠٪.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computed from the approved readings of the measuring indicator, not from task completion. The raw achievement can exceed 100%; the counted value is capped at 100%."
          }
        }
      }
    },
    "يُحفظ التوقيع مع القرار في سجل التدقيق ولا يمكن تعديله أو حذفه بعد الاعتماد.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The signature is stored with the decision in the audit trail and cannot be edited or deleted after approval."
          }
        }
      }
    },
    "يُطلب توقيعك بإصبعك قبل كل اعتماد ويُحفظ مع القرار": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You sign with your finger before every approval, and the signature is stored with the decision"
          }
        }
      }
    },
    "يُعتمد التعريف عند حفظه، ويسري من بداية الشهر الحالي.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The definition is approved when saved and applies from the start of the current month."
          }
        }
      }
    },
    "يُنشئ مدير النظام الفترات قبل بدء المتابعة.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system administrator creates the periods before tracking begins."
          }
        }
      }
    }
  }
}