// Non-secret build settings. Real values are supplied at build time by
// CI variables (HC_*) or an untracked Config/Local.xcconfig — never committed.
// A placeholder bundle id makes an unsigned simulator build possible and can
// never be mistaken for a real identity.
HC_APP_BUNDLE_ID = invalid.hadctrl.app
HC_APPLE_TEAM_ID =
// Signing: Automatic by default (a Mac with any Apple ID can run on a device);
// the signed-IPA workflow sets Manual + distribution identity + profile.
HC_CODE_SIGN_STYLE = Automatic
HC_CODE_SIGN_IDENTITY = Apple Development
HC_PROVISIONING_PROFILE =
// Empty: no push entitlement unless the signing profile includes it (D-36).
HC_CODE_SIGN_ENTITLEMENTS =
// "https:/$()/" keeps the double slash from being read as an xcconfig comment.
HC_SUPABASE_URL = https:/$()/vffusttzqmerfofqianz.supabase.co
// Publishable (client) key only: public by design, ships in every build, and
// grants nothing without a signed-in user (anon has no table/function access).
// Supplied and approved by the owner on 2026-11-23. Never put a secret/admin
// key here: the app refuses to start with one, and CI scans for them.
HC_SUPABASE_PUBLISHABLE_KEY = sb_publishable__q7R9yYmhyXRBznOYjyvRg_PWgaKdBh
#include? "Local.xcconfig"
